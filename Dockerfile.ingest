# syntax=docker/dockerfile:1
# ukmesh-planner ingester image. Build context = repository root.
# This is the ONLY planner container that joins the source DB network and the
# only one that receives SOURCE_DB_READONLY_URL.
FROM node:22-alpine AS runtime

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/rf-core/package.json packages/rf-core/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/ingest/package.json apps/ingest/
RUN npm ci --no-audit --no-fund

COPY packages/contracts packages/contracts
COPY packages/rf-core packages/rf-core
COPY apps/ingest apps/ingest

ENV NODE_ENV=production

HEALTHCHECK --interval=60s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["npx", "tsx", "apps/ingest/src/main.ts"]
