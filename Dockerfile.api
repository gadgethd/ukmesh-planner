# syntax=docker/dockerfile:1
# ukmesh-planner API image. Build context = repository root.
FROM node:22-alpine AS runtime

WORKDIR /app

# Layer-cache friendly: manifests first.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/rf-core/package.json packages/rf-core/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/ingest/package.json apps/ingest/
RUN npm ci --no-audit --no-fund

# Sources (only what the API needs).
COPY packages/contracts packages/contracts
COPY packages/rf-core packages/rf-core
COPY apps/api apps/api

ENV NODE_ENV=production
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "apps/api/src/server.ts"]
