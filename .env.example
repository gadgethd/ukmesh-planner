# ukmesh-planner — environment template
# Copy to .env and fill values. NEVER commit the filled file.
# Secrets live only in host-side env files (0600) and deployment secrets;
# they must never appear in Git, CI logs, client bundles or screenshots.

# --- Ingester (only service that ever sees the source DB credential) -------
# SELECT-only role; see db/source-export-provision/. ≤2 connections.
SOURCE_DB_READONLY_URL=postgres://ukmesh_planner_reader:CHANGE_ME@meshcore-infra-timescaledb-1:5432/meshcore

# --- Planner datastore ------------------------------------------------------
PLANNER_DB_URL=postgres://planner:CHANGE_ME@ukmesh-planner-db:5432/planner
# Password for the planner-owned Postgres (compose builds PLANNER_DB_URL from
# it when PLANNER_DB_URL is not set explicitly).
PLANNER_DB_PASSWORD=CHANGE_ME

# --- Web --------------------------------------------------------------------
# Host-loopback port for the web container (Cloudflare tunnel target).
PLANNER_WEB_PORT=3400
# Deploy-time: read-only path to the existing UK Mesh terrain tile set.
# TERRAIN_TILES_PATH=/home/ben/ukmesh/meshcore-analytics/terrain-tiles

# --- Cloudflare tunnel (Stage 7) --------------------------------------------
# PLANNER_TUNNEL_TOKEN=

# --- API --------------------------------------------------------------------
PORT=8080
# Public origin used for same-origin checks (production value set at deploy).
PUBLIC_ORIGIN=https://planner.ukmesh.com

# --- Ingest schedule --------------------------------------------------------
SNAPSHOT_REFRESH_SECONDS=900
FENCE_CHECK_SECONDS=30

# --- ingester tuning (optional; defaults shown) -------------------------
INGEST_INTERVAL_MS=600000
INGEST_JITTER_MS=60000
INGEST_STATEMENT_TIMEOUT_MS=30000
INGEST_PRUNE_KEEP=5
INGEST_REPEATER_MIN=100
INGEST_REPEATER_MAX=50000
INGEST_LINK_MIN=100
INGEST_LINK_MAX=2000000
INGEST_SHRINK_RATIO_MIN=0.7
INGEST_GROW_RATIO_MAX=2
