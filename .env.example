# ukmesh-planner — environment template
# Copy to .env and fill values. NEVER commit the filled file.
# Secrets live only in host-side env files (0600) and deployment secrets;
# they must never appear in Git, CI logs, client bundles or screenshots.

# --- Ingester (only service that ever sees the source DB credential) -------
# SELECT-only role; see db/source-export-provision/. ≤2 connections.
SOURCE_DB_READONLY_URL=postgres://ukmesh_planner_reader:CHANGE_ME@meshcore-infra-timescaledb-1:5432/meshcore

# --- Planner datastore ------------------------------------------------------
PLANNER_DB_URL=postgres://planner:CHANGE_ME@ukmesh-planner-db:5432/planner

# --- API --------------------------------------------------------------------
PORT=8080
# Public origin used for same-origin checks (production value set at deploy).
PUBLIC_ORIGIN=https://planner.ukmesh.com

# --- Ingest schedule --------------------------------------------------------
SNAPSHOT_REFRESH_SECONDS=900
FENCE_CHECK_SECONDS=30
