{
  "name": "ukmesh-planner",
  "private": true,
  "version": "0.1.0-stage1",
  "description": "UK Mesh repeater planner \u2014 independent planning application (planner.ukmesh.com)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:webgpu": "npm run build:wasm --workspace @ukmesh-planner/web && playwright test --config tools/webgpu/playwright.config.ts",
    "benchmark:webgpu": "WEBGPU_BENCHMARK=1 npm run test:webgpu -- --grep benchmark",
    "fixtures:webgpu": "node --import tsx tools/webgpu/generate-reference.ts",
    "typecheck:webgpu": "tsc --noEmit -p tools/webgpu/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
