# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
# Test-coverage output only — NOT source directories named `coverage`
# (e.g. apps/web/src/compute/coverage).
/coverage/
apps/*/coverage/
packages/*/coverage/
*.tsbuildinfo

# Env & secrets — never commit
.env
.env.*
!.env.example

# Logs / runtime
*.log
logs/
tmp/
.pgdata/
pgdata/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test artifacts
playwright-report/
test-results/
.e2e-artifacts/
.tokensave/

# Built WASM artifacts (produced by `npm run build:wasm`)
apps/web/public/wasm/*.wasm
apps/web/public/wasm/*.wat
